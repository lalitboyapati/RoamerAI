# Server-side scripts only (pull_data.py / index_typesense.py). Never ships to the browser.
#
# Local Docker (what `npm run ts:up` starts):
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_ADMIN_KEY=roamerai-dev-admin

# Typesense Cloud instead:
# TYPESENSE_HOST=xxxxx-1.a1.typesense.net
# TYPESENSE_PORT=443
# TYPESENSE_PROTOCOL=https
# TYPESENSE_ADMIN_KEY=<admin key from the cluster dashboard>
